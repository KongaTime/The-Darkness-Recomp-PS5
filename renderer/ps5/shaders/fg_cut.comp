#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0) uniform sampler2D previousImage;
layout(binding=1) uniform sampler2D currentImage;
layout(std430,binding=2) buffer Cut {uint changed;};
shared float difference[256];
void main() {
    uint at=gl_LocalInvocationIndex;
    vec2 uv=(vec2(gl_LocalInvocationID.xy)+0.5)/16;
    difference[at]=abs(texture(previousImage,uv).r-texture(currentImage,uv).r);
    barrier();
    for(uint stride=128;stride>0;stride>>=1) {
        if(at<stride)difference[at]+=difference[at+stride];
        barrier();
    }
    if(at==0)changed=difference[0]/256>0.22?1:0;
}
