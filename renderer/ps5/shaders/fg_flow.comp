#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D sourceImage;
layout(binding=1) uniform sampler2D targetImage;
layout(binding=2) uniform sampler2D parentFlow;
layout(binding=3,rgba32f) uniform writeonly image2D outputFlow;
layout(push_constant) uniform Params {uvec4 sizes;vec4 settings;} p;
void main() {
    ivec2 cell=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(cell,imageSize(outputFlow))))return;
    ivec2 size=textureSize(sourceImage,0),origin=cell*4;
    vec2 estimate=p.sizes.z==1?vec2(0):texture(parentFlow,(vec2(origin)+2)/vec2(size)).xy*p.settings.xy;
    float reference[16];float low=1,high=0;
    for(int y=0;y<4;++y)for(int x=0;x<4;++x) {
        float a=texelFetch(sourceImage,clamp(origin+ivec2(x,y),ivec2(0),size-1),0).r;
        reference[y*4+x]=a;low=min(low,a);high=max(high,a);
    }
    float best=1e20,bestCost=1;vec2 motion=estimate;
    // Do not search most of a tiny pyramid image: repeated coarse texture
    // otherwise wins at an unrelated, very large displacement.
    int radius=min(int(p.sizes.w),max(1,min(size.x,size.y)/4));
    for(int dy=-radius;dy<=radius;++dy)for(int dx=-radius;dx<=radius;++dx) {
        vec2 delta=vec2(dx,dy),candidate=estimate+delta;
        float cost=0,validCount=0;
        for(int y=0;y<4;++y)for(int x=0;x<4;++x) {
            vec2 q=vec2(clamp(origin+ivec2(x,y),ivec2(0),size-1))+candidate;
            if(any(lessThan(q,vec2(0))) || any(greaterThan(q,vec2(size-1))))continue;
            cost+=abs(reference[y*4+x]-texture(targetImage,(q+0.5)/vec2(size)).r);validCount+=1;
        }
        if(validCount<8)continue;
        cost/=validCount;
        float score=cost+0.0001*dot(delta,delta)+0.0005*(16-validCount);
        if(score<best) {best=score;bestCost=cost;motion=candidate;}
    }
    // Subpixel Gauss-Newton refinement at the finest level.
    if(p.sizes.z==2)for(int iteration=0;iteration<2;++iteration) {
        float xx=0,xy=0,yy=0;vec2 rhs=vec2(0);
        for(int y=0;y<4;++y)for(int x=0;x<4;++x) {
            vec2 q=vec2(clamp(origin+ivec2(x,y),ivec2(0),size-1))+motion;
            vec2 uv=(q+0.5)/vec2(size),step=1.0/vec2(size);
            vec2 gradient=vec2(texture(targetImage,uv+vec2(step.x,0)).r-texture(targetImage,uv-vec2(step.x,0)).r,
                texture(targetImage,uv+vec2(0,step.y)).r-texture(targetImage,uv-vec2(0,step.y)).r)*0.5;
            float residual=reference[y*4+x]-texture(targetImage,uv).r;
            xx+=gradient.x*gradient.x;xy+=gradient.x*gradient.y;yy+=gradient.y*gradient.y;rhs+=gradient*residual;
        }
        float determinant=xx*yy-xy*xy;
        if(determinant<1e-8)break;
        vec2 correction=vec2(yy*rhs.x-xy*rhs.y,xx*rhs.y-xy*rhs.x)/determinant;
        motion+=clamp(correction,vec2(-1),vec2(1));
    }
    float finalCost=0;
    for(int y=0;y<4;++y)for(int x=0;x<4;++x) {
        vec2 q=vec2(clamp(origin+ivec2(x,y),ivec2(0),size-1))+motion;
        finalCost+=abs(reference[y*4+x]-texture(targetImage,(q+0.5)/vec2(size)).r);
    }
    imageStore(outputFlow,cell,vec4(motion,finalCost/16,high-low));
}
